index dbbe04624a266f34bd194d3f3c25414869e49e04..89f5af3207f1861f850a0b9bcf4a451d066514b3 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -2,16 +2,13 @@ def safeExtGet(prop, fallback) {
     rootProject.ext.has(prop) ? rootProject.ext.get(prop) : fallback
 }
 
-buildscript {
-    repositories {
-        jcenter()
-    }
-
-    dependencies {
-        classpath 'com.android.tools.build:gradle:1.3.1'
-    }
-}
-
+// The upstream buildscript{} block here declared its own ancient AGP
+// (1.3.1) via the long-defunct jcenter() repository, which modern Gradle
+// doesn't even expose a jcenter() method for anymore ("Could not find
+// method jcenter()") — breaking any release build. Autolinked modules
+// don't need their own buildscript block at all: the Android Gradle Plugin
+// is already applied by the root project, so `apply plugin:
+// 'com.android.library'` below just uses that.
 apply plugin: 'com.android.library'
 
 android {
