# Production React Native frontend environment.
# Not read by Metro directly. Before building a release APK, copy this file's
# values into .env, build, then restore your local .env values afterward.

KIS_ENV=production

# Use deployed production backends, not local machine.
KIS_USE_LOCAL_BACKENDS=false
KIS_DEV_BACKEND_HOST=

# Production Django API
KIS_DJANGO_BASE_URL=https://api.kingdomimpactventures.org

# Production Nest / realtime / push notification backend
KIS_NEST_BASE_URL=https://chat.kingdomimpactventures.org

# WebSocket endpoint
KIS_CHAT_WS_URL=https://chat.kingdomimpactventures.org
KIS_CHAT_WS_PATH=/ws

# Media / verification
KIS_MEDIA_VERIFICATION_ENABLED=true

# Email/SMS OTP has been fully removed. KIS Auth (Google-backed identity,
# kisauth.kingdomimpactventures.org) is the production default for
# registration, linking, recovery, and email verification. Backend gates
# (KIS_AUTH_ENABLED, KIS_AUTH_REGISTRATION_ENABLED, KIS_AUTH_RECOVERY_ENABLED,
# KIS_AUTH_LINK_ENABLED in Django) must be flipped to match.
KIS_AUTH_RECOVERY_ENABLED=true
KIS_AUTH_LINK_ENABLED=true
KIS_AUTH_REGISTRATION_ENABLED=true

# Tenor GIF search (in-chat GIF picker). Without a real key, GIF search
# always returns empty results ("No GIFs found" — AND-034). Get a production
# key from https://developers.google.com/tenor/guides/quickstart and set it
# here; there is no working fallback key for production builds.
KIS_TENOR_API_KEY=
