# ios/Podfile

require 'json'

# Helper to resolve scripts using Node (works with hoisting/pnpm/etc.)
def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# React Native core pods
node_require('react-native/scripts/react_native_pods.rb')

# React Native Permissions setup
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# ✅ Enable all permissions you’re likely to need for KIS
# (You can always remove some later if you’re sure you don’t need them.)
setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'LocationWhenInUse',
  'LocationAlways',        # uncomment if you really need background location
  'Contacts',
  'Calendars',
  'Reminders',
  'Motion',
  'MediaLibrary',
  'Bluetooth',
  'SpeechRecognition',
  'Siri',
  'FaceID',
  'Notifications',
])

# @react-native-firebase 26+ defaults to resolving Firebase via Swift Package
# Manager, but this project deliberately pins Firebase to CocoaPods (see the
# explicit `pod 'FirebaseX', :modular_headers => true` lines below) — mixing
# the two makes RNFBApp/RNFBMessaging pull in their own SPM copy of Firebase
# alongside the CocoaPods one, which collides at link time under static
# linkage ("SPM + static linkage is not supported"). Opt back into the
# CocoaPods-only resolution this Podfile already expects.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'KIS' do
  config = use_native_modules!

  # Firebase modular headers for static library integration without
  # forcing modular headers globally (which can break React pod modulemaps).
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'PromisesObjC', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ❌ REMOVE your old custom react-native-permissions block.
  # (The add_rn_permission / permissions_pkg_json block is no longer needed.)

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        # Some pods (e.g. FBLPromises_Privacy, RNImagePickerPrivacyInfo resource
        # bundles) ship with an unset/ancient IPHONEOS_DEPLOYMENT_TARGET (9.0),
        # which current Xcode rejects outright (min supported is 12.0). Floor
        # every pod target to the app's own minimum so `pod install` output
        # always builds on the toolchain in use.
        pod_target_version = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if pod_target_version && Gem::Version.new(pod_target_version) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
